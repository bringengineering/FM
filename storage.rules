rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isFieldUser() {
      return request.auth != null &&
        request.auth.token.get('fieldPlatform', false) == true;
    }

    function ownsPath(uid) {
      return isFieldUser() && request.auth.uid == uid;
    }

    match /field-media/{uid}/{captureSessionId}/photos/{fileName} {
      allow read: if ownsPath(uid) ||
        (isFieldUser() && request.auth.token.fieldRole in ['reviewer', 'admin']);
      allow create, update: if ownsPath(uid) &&
        request.resource != null &&
        request.resource.size <= 25 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    match /field-media/{uid}/{captureSessionId}/videos/{fileName} {
      allow read: if ownsPath(uid) ||
        (isFieldUser() && request.auth.token.fieldRole in ['reviewer', 'admin']);
      allow create, update: if ownsPath(uid) &&
        request.resource != null &&
        request.resource.size <= 500 * 1024 * 1024 &&
        request.resource.contentType.matches('video/.*');
      allow delete: if false;
    }
  }
}
