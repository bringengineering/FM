{
  "name": "bring-care-company-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "pnpm sync:field-map",
    "dev": "vinext dev",
    "prebuild": "pnpm sync:field-map",
    "build": "vinext build",
    "sync:field-map": "node scripts/sync-field-map.mjs",
    "assets:field-icons": "node scripts/generate-field-icons.mjs",
    "export:firebase": "node scripts/export-firebase.mjs",
    "start": "vinext start",
    "test": "pnpm run build && node --test tests/rendered-html.test.mjs",
    "test:field": "vitest",
    "test:field:run": "vitest run tests/field",
    "typecheck:field": "tsc -p tsconfig.field.json",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "idb": "^8.0.3",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^30.0.1",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "0.34.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
