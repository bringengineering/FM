{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true,
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "next-env.d.ts",
    "app/field/**/*.ts",
    "app/field/**/*.tsx",
    "tests/field/**/*.ts",
    "tests/field/**/*.tsx",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", ".next", "dist"]
}
