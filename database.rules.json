{
  "rules": {
    ".read": false,
    ".write": false,
    "workflow": {
      ".read": true,
      ".write": true
    },
    "caseSettings": {
      ".read": true,
      ".write": true
    },
    "cases": {
      ".read": true,
      ".write": true
    },
    "paymentCalendars": {
      "shared": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "signage": {
      ".read": true,
      ".write": true
    }
  }
}
